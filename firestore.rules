rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Пространство синхронизации. Адрес — SHA-256 от ключа (120 бит), поэтому
    // знание адреса и есть право доступа. Перечисление КОЛЛЕКЦИИ spaces при
    // этом невозможно: правил на сам документ spaces/{id} нет, только на
    // известные подколлекции — иначе адреса можно было бы просто выгрузить.
    match /spaces/{spaceId}/decks/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /spaces/{spaceId}/words/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /spaces/{spaceId}/stats/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Одноразовый код переноса: живёт 10 минут и гасится при первом чтении.
    // Форма записи задана жёстко, чтобы коллекцию нельзя было использовать
    // как бесплатное хранилище, а срок — чтобы код нельзя было выдать надолго.
    match /pairings/{code} {
      allow get, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['key', 'exp'])
        && request.resource.data.key is string
        && request.resource.data.key.size() <= 32
        && request.resource.data.exp is int
        && request.resource.data.exp <= request.time.toMillis() + 15 * 60 * 1000;
      allow list: if false;
    }

    // Старые аккаунтные поддеревья: только чтение своего, для разового
    // переноса в пространство. Записи больше нет.
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Глобальный кеш видео: только сервер (Admin SDK обходит правила).
    match /videos/{videoId}/{document=**} {
      allow read, write: if false;
    }
  }
}
